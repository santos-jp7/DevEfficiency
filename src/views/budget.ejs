<head>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            color: #333;
            line-height: 1.5;
            margin: 0;
            padding: 40px;
            background-color: #fff;
        }

        /* Topo e Cabeçalho */
        .header-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        h1 {
            margin: 0;
            font-size: 28px;
            color: #1a1a1a;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .company-info b {
            font-size: 18px;
            color: #000;
            display: block;
        }

        /* Estrutura de Colunas */
        .grid-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            margin-bottom: 30px;
        }

        .section-title {
            font-size: 12px;
            font-weight: 700;
            color: #888;
            text-transform: uppercase;
            margin-bottom: 8px;
            border-bottom: 1px solid #eee;
            padding-bottom: 4px;
        }

        .info-box span {
            display: block;
            font-size: 14px;
        }

        /* Tabelas */
        table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
        }

        th {
            text-align: left;
            background-color: #f8f9fa;
            color: #666;
            font-size: 13px;
            font-weight: 600;
            padding: 12px 10px;
            text-transform: uppercase;
        }

        td {
            padding: 12px 10px;
            border-bottom: 1px solid #eee;
            font-size: 14px;
        }

        tr:last-child td {
            border-bottom: none;
        }

        h2 {
            font-size: 16px;
            margin-top: 30px;
            color: #444;
        }

        /* Resumo de Valores */
        .summary-container {
            display: flex;
            justify-content: flex-end;
            margin-top: 30px;
        }

        .summary-box {
            width: 300px;
        }

        .summary-line {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            font-size: 14px;
        }

        .summary-line.total-main {
            border-top: 2px solid #333;
            margin-top: 10px;
            padding-top: 15px;
            font-weight: 700;
            font-size: 18px;
            color: #000;
        }

        .text-right {
            text-align: right;
        }

        hr {
            border: 0;
            border-top: 1px solid #eee;
            margin: 20px 0;
        }
    </style>
</head>

<body>
    <header class="header-nav">
        <img src="<%= configMap['logo'] || 'https://placehold.co/80x40?text=Logo' %>" alt="Logo" width="80" />
        <h1>
            <%= ( os.Protocol?.status=="Em aberto" ? "Orçamento" : (os.Protocol?.status=="Liberado para pagamento"
                ? "Fatura" : (os.Protocol?.status=="Fechado" ? "Recibo" : "Documento" ) ) ) %>
        </h1>
    </header>

    <div class="grid-container">
        <div class="info-box">
            <div class="section-title">Emissor</div>
            <b>
                <%= configMap['name'] || 'Empresa' %>
            </b>
            <span>
                <%= configMap['company_description'] || 'Descrição da empresa' %>
            </span>
            <span>
                <%= configMap['contact'] || 'Contato da empresa' %>
            </span>
        </div>

        <div class="info-box text-right">
            <div class="section-title">Identificação</div>
            <span><strong>Nº OS:</strong>
                <%= os.id %>
            </span>
            <span><strong>Data:</strong>
                <%= ` ${String(new Date().getDate()).padStart(2, "0" )}/${String(new
                    Date().getMonth()+1).padStart(2, "0" )}/${new Date().getFullYear()}`%>
            </span>
        </div>
    </div>

    <div class="grid-container">
        <div class="info-box">
            <div class="section-title">Cliente</div>
            <b>
                <%= os.Client?.name || os.Project?.Client?.name %>
            </b>
            <span>
                <%= os.Client?.email || os.Project?.Client?.email %>
            </span>
        </div>

        <div class="info-box text-right">
            <div class="section-title">Referência</div>
            <span>
                <%= os.ProjectId ? `Projeto: ${os.Project?.name}` : "" %>
            </span>
            <span><strong>Assunto:</strong>
                <%= os.subject %>
            </span>
        </div>
    </div>

    <section style="margin-bottom: 40px;">
        <div class="section-title">Descrição dos Serviços</div>
        <p style="font-size: 14px; color: #555;">
            <%= os.description %>
        </p>
    </section>

    <% if(os.Protocol?.Protocol_registers?.length> 0){ %>
        <section>
            <h2>Serviços e Despesas</h2>
            <table>
                <thead>
                    <tr>
                        <th>Descrição</th>
                        <th>Tipo</th>
                        <th class="text-right">Valor</th>
                    </tr>
                </thead>
                <tbody>
                    <% for(let register of os.Protocol?.Protocol_registers){ %>
                        <tr>
                            <td>
                                <%= register.description %>
                            </td>
                            <td><small>
                                    <%= register.type %>
                                </small></td>
                            <td class="text-right">
                                <%= (register.value).toLocaleString('pt-br',{style: 'currency' , currency: 'BRL' }) %>
                            </td>
                        </tr>
                        <% } %>
                </tbody>
            </table>
        </section>
        <% } %>

            <% if(os.Protocol?.Protocol_products?.length> 0){ %>
                <section>
                    <h2>Produtos</h2>
                    <table>
                        <thead>
                            <tr>
                                <th style="width: 50px;">Cod.</th>
                                <th>Descrição</th>
                                <th>Cobrança</th>
                                <th class="text-right">Valor</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for(let product of os.Protocol?.Protocol_products){ %>
                                <tr>
                                    <td>#<%= product.ProductId %>
                                    </td>
                                    <td>
                                        <%= product.Product?.description %>
                                    </td>
                                    <td>
                                        <%= product.charge_type %>
                                    </td>
                                    <td class="text-right">
                                        <%= (product.value).toLocaleString('pt-br',{style: 'currency' , currency: 'BRL'
                                            }) %>
                                    </td>
                                </tr>
                                <% } %>
                        </tbody>
                    </table>
                </section>
                <% } %>

                    <div class="summary-container">
                        <div class="summary-box">
                            <div class="summary-line">
                                <span>Subtotal:</span>
                                <span>
                                    <%= ((os.Protocol?.Protocol_registers?.reduce((sum, v)=> sum + v.value, 0) || 0) +
                                        (os.Protocol?.Protocol_products?.reduce((sum, v) => sum + v.value, 0) ||
                                        0)).toLocaleString('pt-br',{style: 'currency', currency: 'BRL'}) %>
                                </span>
                            </div>

                            <% if(os.Protocol?.Receipts?.length> 0){ %>
                                <div class="summary-line" style="color: #27ae60;">
                                    <span>Total Pago:</span>
                                    <span>
                                        - <%= ((os.Protocol?.Receipts?.reduce((sum, v)=> sum + v.value,
                                            0))).toLocaleString('pt-br',{style: 'currency', currency: 'BRL'}) %>
                                    </span>
                                </div>
                                <% } %>

                                    <div class="summary-line total-main">
                                        <span>
                                            <%= os.Protocol?.status=="Liberado para pagamento" ? "Total a Pagar"
                                                : "Total Geral" %>:
                                        </span>
                                        <span>
                                            <%= ( (os?.Protocol?.Protocol_registers?.reduce((sum, v)=> sum + v.value, 0)
                                                || 0) +
                                                (os?.Protocol?.Protocol_products?.reduce((sum, v) => sum + v.value, 0)
                                                || 0) -
                                                (os?.Protocol?.Receipts?.reduce((sum, v) => sum + v.value, 0) || 0)
                                                ).toLocaleString('pt-br', { style: 'currency', currency: 'BRL' }) %>
                                        </span>
                                    </div>
                        </div>
                    </div>
</body>