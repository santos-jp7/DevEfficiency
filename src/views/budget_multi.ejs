<head>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');

        body {
            font-family: 'Inter', sans-serif;
            color: #333;
            line-height: 1.6;
            margin: 0;
            padding: 40px;
            background-color: #fff;
        }

        /* Topo */
        .header-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
        }

        h1 {
            margin: 0;
            font-size: 24px;
            color: #1a1a1a;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Infos Iniciais */
        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            margin-bottom: 40px;
        }

        .section-label {
            font-size: 11px;
            font-weight: 700;
            color: #999;
            text-transform: uppercase;
            border-bottom: 1px solid #eee;
            margin-bottom: 8px;
            padding-bottom: 4px;
        }

        .company-name {
            font-size: 18px;
            font-weight: 700;
            display: block;
        }

        .client-name {
            font-size: 16px;
            font-weight: 600;
            display: block;
        }

        .text-muted {
            font-size: 13px;
            color: #666;
        }

        /* Card de Cada OS */
        .os-card {
            border: 1px solid #f0f0f0;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 30px;
            background-color: #fafafa;
        }

        .os-header {
            margin-bottom: 15px;
        }

        .os-title {
            font-size: 16px;
            font-weight: 700;
            color: #2c3e50;
            display: block;
        }

        /* Tabelas */
        table {
            width: 100%;
            border-collapse: collapse;
            margin: 10px 0;
            background: #fff;
            border-radius: 4px;
            overflow: hidden;
        }

        th {
            background-color: #f1f1f1;
            color: #666;
            font-size: 12px;
            padding: 10px;
            text-align: left;
            text-transform: uppercase;
        }

        td {
            padding: 10px;
            border-bottom: 1px solid #eee;
            font-size: 13px;
        }

        .text-right {
            text-align: right;
        }

        h2 {
            font-size: 14px;
            margin: 20px 0 10px 0;
            color: #555;
            text-transform: uppercase;
        }

        /* Rodapé de Totais */
        .total-container {
            display: flex;
            justify-content: flex-end;
            margin-top: 50px;
            border-top: 2px solid #eee;
            padding-top: 20px;
        }

        .total-box {
            width: 320px;
        }

        .total-line {
            display: flex;
            justify-content: space-between;
            padding: 6px 0;
            font-size: 14px;
        }

        .total-line.grand-total {
            margin-top: 10px;
            padding: 15px 0;
            font-weight: 700;
            font-size: 20px;
            color: #000;
            border-top: 1px solid #333;
        }

        .status-badge {
            font-size: 10px;
            padding: 2px 8px;
            border-radius: 12px;
            background: #eee;
            margin-left: 10px;
            vertical-align: middle;
        }
    </style>
</head>

<body>
    <header class="header-nav">
        <img src="<%= configMap['logo'] || 'https://placehold.co/80x40?text=Logo' %>" alt="Logo" width="70" />
        <h1>
            <%= ( type=="Em aberto" ? "Orçamento Coletivo" : (type=="Liberado para pagamento" ? "Fatura Consolidada"
                : "Recibo" ) ) %>
        </h1>
    </header>

    <div class="info-grid">
        <div>
            <div class="section-label">Emissor</div>
            <span class="company-name">
                <%= configMap['name'] || 'Empresa' %>
            </span>
            <span class="text-muted">
                <%= configMap['company_description'] || 'Descrição da empresa' %>
            </span>
            <span class="text-muted">
                <%= configMap['contact'] || 'Contato da empresa' %>
            </span>
        </div>
        <div class="text-right">
            <div class="section-label">Cliente</div>
            <span class="client-name">
                <%= client.name %>
            </span>
            <span class="text-muted">
                <%= client.email %>
            </span>
        </div>
    </div>

    <span class="text-muted">Data de Emissão: <%= new Date().toLocaleDateString('pt-BR') %></span>

    <% for(let os of oss){ %>
        <div class="os-card">
            <div class="os-header">
                <div class="section-label">Referência: OS #<%= os.id %>
                </div>
                <span class="os-title">
                    <%= os.ProjectId ? `[${os.Project?.name}] ` : "" %>
                        <%= os.subject %>
                </span>
                <p class="text-muted" style="margin: 5px 0;">
                    <%= os.description %>
                </p>
            </div>

            <% if(os.Protocol?.Protocol_registers?.length> 0){ %>
                <table>
                    <thead>
                        <tr>
                            <th>Serviços e Despesas</th>
                            <th>Tipo</th>
                            <th class="text-right">Valor</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for(let register of os.Protocol?.Protocol_registers){ %>
                            <tr>
                                <td>
                                    <%= register.description %>
                                </td>
                                <td><small>
                                        <%= register.type %>
                                    </small></td>
                                <td class="text-right">
                                    <%= register.value.toLocaleString('pt-br',{style: 'currency' , currency: 'BRL' }) %>
                                </td>
                            </tr>
                            <% } %>
                    </tbody>
                </table>
                <% } %>

                    <% if(os.Protocol?.Protocol_products?.length> 0){ %>
                        <table>
                            <thead>
                                <tr>
                                    <th style="width: 40px;">#</th>
                                    <th>Produto</th>
                                    <th>Cobrança</th>
                                    <th class="text-right">Valor</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% for(let product of os.Protocol?.Protocol_products){ %>
                                    <tr>
                                        <td>
                                            <%= product.ProductId %>
                                        </td>
                                        <td>
                                            <%= product.Product?.description %>
                                        </td>
                                        <td>
                                            <%= product.charge_type %>
                                        </td>
                                        <td class="text-right">
                                            <%= product.value.toLocaleString('pt-br',{style: 'currency' ,
                                                currency: 'BRL' }) %>
                                        </td>
                                    </tr>
                                    <% } %>
                            </tbody>
                        </table>
                        <% } %>
        </div>
        <% } %>

            <% for(let subscription of subscriptions){ %>
                <div class="os-card">
                    <div class="os-header">
                        <div class="section-label">Referência: Assinatura #<%= subscription.id %>
                        </div>
                        <span class="os-title">
                            <%= subscription.name %>
                        </span>
                        <p class="text-muted" style="margin: 5px 0;">Projeto: #<%= subscription.Project?.id %> - <%=
                                    subscription.Project?.name %>
                        </p>
                    </div>


                    <% if(subscription.Protocols?.length> 0){ %>
                        <% for(let protocol of subscription.Protocols){ %>
                            <% if(protocol.Protocol_products?.length> 0){ %>
                                <table>
                                    <thead>
                                        <tr>
                                            <th style="width: 40px;">#</th>
                                            <th>Produto</th>
                                            <th>Cobrança</th>
                                            <th class="text-right">Valor</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% for(let product of protocol.Protocol_products){ %>
                                            <tr>
                                                <td>
                                                    <%= product.ProductId %>
                                                </td>
                                                <td>
                                                    <%= product.Product?.description %>
                                                </td>
                                                <td>
                                                    <%= product.charge_type %>
                                                </td>
                                                <td class="text-right">
                                                    <%= product.value.toLocaleString('pt-br',{style: 'currency' ,
                                                        currency: 'BRL' }) %>
                                                </td>
                                            </tr>
                                            <% } %>
                                    </tbody>
                                </table>
                                <% } %>
                                    <% } %>
                                        <% } %>
                </div>
                <% } %>
                    <div class="total-container">
                        <div class="total-box">
                            <div class="total-line">
                                <span>Subtotal Consolidado:</span>
                                <span>
                                    <% let total=oss.reduce((sum, os) => {
                                        const gross = (os.Protocol?.Protocol_registers?.reduce((s,v) => s+v.value, 0)||0)
                                                    + (os.Protocol?.Protocol_products?.reduce((s,v) => s+v.value, 0)||0)
                                        const disc = Number(os.Protocol?.discount_value) || 0
                                        return sum + gross - disc
                                        }, 0)
                                        +
                                        subscriptions.reduce((sum, sub) => {
                                        return sum + (sub.Protocols?.reduce((s2, p) => {
                                        const gross = (p.Protocol_registers?.reduce((s,v) => s+v.value, 0)||0)
                                                    + (p.Protocol_products?.reduce((s,v) => s+v.value, 0)||0)
                                        const disc = Number(p.discount_value) || 0
                                        return s2 + gross - disc
                                        }, 0)||0)
                                        }, 0)
                                        %>

                                        <%= total.toLocaleString('pt-br',{style: 'currency' , currency: 'BRL' }) %>
                                </span>
                            </div>

                            <% let totalPago=oss.map( os=> os.Protocol?.Receipts?.reduce((
                                sum, v) => sum + v.value, 0) || 0).reduce((
                                sum, v) => sum + v, 0)
                                +
                                subscriptions.map(
                                subscription=>subscription.Protocol?.Receipts?.reduce((
                                sum, v) => sum + v.value, 0) || 0).reduce((
                                sum, v) => sum + v, 0);

                                if(totalPago > 0){
                                %>
                                <div class="total-line" style="color: #27ae60;">
                                    <span>Total já Pago:</span>
                                    <span>- <%= totalPago.toLocaleString('pt-br',{style: 'currency' , currency: 'BRL' })
                                            %>
                                    </span>
                                </div>
                                <% } %>

                                    <div class="total-line grand-total">
                                        <span>Total a Pagar:</span>
                                        <span>
                                            <%= ( total - totalPago ).toLocaleString('pt-br', { style: 'currency' ,
                                                currency: 'BRL' }) %>
                                        </span>
                                    </div>
                        </div>
                    </div>
</body>