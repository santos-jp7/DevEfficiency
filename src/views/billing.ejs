<head>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');

        body {
            font-family: 'Inter', sans-serif;
            color: #333;
            line-height: 1.5;
            margin: 0;
            padding: 40px;
            background-color: #fff;
        }

        /* Topo da Fatura */
        .header-nav {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 30px;
        }

        .billing-title {
            text-align: right;
        }

        h1 {
            margin: 0;
            font-size: 26px;
            color: #1a1a1a;
            font-weight: 700;
        }

        .invoice-number {
            color: #666;
            font-size: 14px;
            font-weight: 400;
        }

        /* Grid de Informações */
        .info-grid {
            display: grid;
            grid-template-columns: 1.5fr 1fr;
            gap: 40px;
            margin-bottom: 30px;
            padding: 20px 0;
            border-top: 1px solid #eee;
            border-bottom: 1px solid #eee;
        }

        .section-label {
            font-size: 10px;
            font-weight: 700;
            color: #999;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 5px;
        }

        .detail-item {
            margin-bottom: 15px;
        }

        .company-name {
            font-size: 18px;
            font-weight: 700;
            color: #000;
        }

        .client-name {
            font-size: 16px;
            font-weight: 600;
        }

        .text-muted {
            font-size: 13px;
            color: #666;
            display: block;
        }

        /* Estilo da Listagem de Protocolos */
        .protocol-row {
            padding: 15px 0;
            border-bottom: 1px solid #f0f0f0;
        }

        .protocol-row:last-child {
            border-bottom: none;
        }

        .protocol-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }

        .protocol-subject {
            font-weight: 600;
            font-size: 14px;
            color: #2c3e50;
        }

        .protocol-id {
            font-size: 11px;
            background: #f1f1f1;
            padding: 2px 8px;
            border-radius: 4px;
            color: #777;
        }

        /* Tabelas Internas */
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
            margin-top: 5px;
        }

        th {
            text-align: left;
            color: #999;
            font-weight: 600;
            padding: 8px 0;
            border-bottom: 1px solid #eee;
        }

        td {
            padding: 8px 0;
            border-bottom: 1px solid #fafafa;
        }

        .text-right {
            text-align: right;
        }

        /* Rodapé de Fechamento */
        .summary-container {
            display: flex;
            justify-content: flex-end;
            margin-top: 40px;
        }

        .summary-box {
            width: 300px;
            background: #fdfdfd;
            padding: 20px;
            border-radius: 8px;
            border: 1px solid #eee;
        }

        .summary-line {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 14px;
        }

        .total-line {
            margin-top: 15px;
            padding-top: 15px;
            border-top: 2px solid #1a1a1a;
            font-weight: 700;
            font-size: 20px;
        }

        .due-date-alert {
            margin-top: 20px;
            padding: 10px;
            background: #fff8e1;
            border-left: 4px solid #ffc107;
            font-size: 12px;
            color: #856404;
        }
    </style>
</head>

<body>
    <header class="header-nav">
        <img src="data:image/png;base64,"
            alt="Logo" width="80" />
        <div class="billing-title">
            <h1>Fatura Mensal</h1>
            <span class="invoice-number">Referência: <%= billing.id %></span>
        </div>
    </header>

    <div class="info-grid">
        <div>
            <div class="section-label">Cliente</div>
            <span class="client-name">
                <%= client.name %>
            </span>
            <span class="text-muted">
                <%= client.email %>
            </span>
            <span class="text-muted">ID Cliente: #<%= client.id %></span>
        </div>
        <div class="text-right">
            <div class="section-label">Dados de Pagamento</div>
            <span class="text-muted">Data de Emissão: <%= new Date().toLocaleDateString('pt-BR') %></span>
            <span class="company-name" style="color: #d32f2f;">Vencimento: <%= `
                    ${String(billing.due_date.getDate()).padStart(2, "0"
                    )}/${String(billing.due_date.getMonth()+1).padStart(2, "0" )}/${billing.due_date.getFullYear()}`%>
                    %></span>
        </div>
    </div>

    <div class="section-label">Detalhamento dos Serviços</div>

    <% for(let item of billing.BillingProtocols){ %>
        <% let p=item.Protocol; %>
            <div class="protocol-row">
                <div class="protocol-header">
                    <span class="protocol-subject">
                        <%= p.Service_order?.subject || p.Subscription?.name || 'Serviços Diversos' %>
                    </span>
                    <span class="protocol-id">Protocolo #<%= p.id %> &bull;
                            <% if(p.Service_order?.id){ %>
                                Ordem de Serviço #<%= p.Service_order.id %>
                                    <% } else if(p.Subscription?.id){ %>
                                        Assinatura #<%= p.Subscription.id %>
                                            <% } %>
                    </span>
                </div>

                <% if(p.Service_order?.Project?.id){ %>
                    <small>Projeto #<%= p.Service_order.Project.id %> - <%= p.Service_order.Project.name %></small>
                    <% } %>

                        <% if(p.Protocol_registers?.length> 0 || p.Protocol_products?.length > 0){ %>
                            <table>
                                <thead>
                                    <tr>
                                        <th>Descrição</th>
                                        <th class="text-right">Qtd/Tipo</th>
                                        <th class="text-right">Valor total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% for(let reg of p.Protocol_registers || []){ %>
                                        <tr>
                                            <td>
                                                <%= reg.description %>
                                            </td>
                                            <td class="text-right">
                                                <%= reg.type %>
                                            </td>
                                            <td class="text-right">
                                                <%= reg.value.toLocaleString('pt-br',{style: 'currency' ,
                                                    currency: 'BRL' }) %>
                                            </td>
                                        </tr>
                                        <% } %>

                                            <% for(let prod of p.Protocol_products || []){ %>
                                                <tr>
                                                    <td>
                                                        <%= prod.Product?.description || 'Produto' %>
                                                    </td>
                                                    <td class="text-right">
                                                        <%= prod.charge_type %>
                                                    </td>
                                                    <td class="text-right">
                                                        <%= prod.value.toLocaleString('pt-br',{style: 'currency' ,
                                                            currency: 'BRL' }) %>
                                                    </td>
                                                </tr>
                                                <% } %>
                                </tbody>
                            </table>
                            <% } %>

                                <div class="protocol-header">
                                    <span class="protocol-subject">
                                        Valor: <%= item.value.toLocaleString('pt-br',{style: 'currency' ,
                                            currency: 'BRL' })%>
                                    </span>
                                    <% if(p.notes?.length> 0){ %>
                                        <span class="protocol-id">Observação: <%= p.notes %></span>
                                        <% } %>
                                </div>
            </div>
            <% } %>

                <div class="summary-container">
                    <div class="summary-box">
                        <div class="section-label">Resumo Financeiro</div>

                        <% let totalBruto=billing.total_value; let totalDescontos=0; %>

                            <div class="summary-line">
                                <span>Total Bruto:</span>
                                <span>
                                    <%= totalBruto.toLocaleString('pt-br',{style: 'currency' , currency: 'BRL' }) %>
                                </span>
                            </div>

                            <% if(totalDescontos> 0) { %>
                                <div class="summary-line" style="color: #27ae60;">
                                    <span>Créditos/Pagos:</span>
                                    <span>- <%= totalDescontos.toLocaleString('pt-br',{style: 'currency' ,
                                            currency: 'BRL' }) %></span>
                                </div>
                                <% } %>

                                    <div class="summary-line total-line">
                                        <span>Total Fatura:</span>
                                        <span>
                                            <%= (totalBruto - totalDescontos).toLocaleString('pt-br', {
                                                style: 'currency' , currency: 'BRL' }) %>
                                        </span>
                                    </div>
                    </div>
                </div>

                <footer style="margin-top: 50px; text-align: center; border-top: 1px solid #eee; padding-top: 20px;">
                    <span class="text-muted">Codlinx Tecnologia LTDA</span>
                    <span class="text-muted" style="font-size: 10px;">CNPJ: 58.942.500/0001-22 | São Paulo -
                        SP</span>
                </footer>
</body>