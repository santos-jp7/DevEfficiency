NODE_ENV=production

PORT=3002

SECRET=secret_pass

DB_NAME=name
DB_USER=user
DB_PASS=pass
DB_HOST=localhost

EMAIL_FROM=user@system.com
EMAIL_NAME=User

EMAIL_USER=user@example.com
EMAIL_PASS=email_pass
EMAIL_HOST=localhost

EMAIL_CC=admin@example.com

# Servidor MCP (controle por IA) em /api/mcp. Desligado se MCP_API_KEY e CF_ACCESS_* estiverem vazios
MCP_API_KEY=
# Login pelo Cloudflare Access (conectores do claude.ai / celular)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# E-mails autorizados no MCP via Access, separados por vírgula (vazio = qualquer um liberado pelo Access)
CF_ACCESS_ALLOWED_EMAILS=
# Ferramentas MCP a desativar, separadas por vírgula (ex.: billing_send_email)
MCP_DISABLE=
